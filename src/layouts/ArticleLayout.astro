---
import BaseLayout from './BaseLayout.astro';
import Btn from '../components/Btn.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { getAssetImage, consultationHero } from '../lib/images';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  readingTime: string;
  heroImage: string;
  category: string;
  relatedTreatments?: string[];
}

const { title, description, pubDate, updatedDate, author, readingTime, heroImage, category, relatedTreatments = [] } = Astro.props;

const treatments = relatedTreatments.length > 0
  ? (await getCollection('treatments')).filter((t) => relatedTreatments.includes(t.id))
  : [];

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: heroImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@id': 'https://www.skinanalysishi.com/#org' },
};
---

<BaseLayout
  title={`${title} | Skin Analysis Journal`}
  description={description}
  type="article"
  pubDate={pubDate}
  ogImage={heroImage}
  currentNav="Journal"
  schema={schema}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-[2px] bg-clay z-[200] transition-[width] duration-100"
    style="width:0%"
    aria-hidden="true"
  ></div>

  <!-- Article header -->
  <div class="max-w-[940px] mx-auto px-gutter pt-[clamp(40px,6vw,72px)] pb-[clamp(32px,4vw,48px)]">
    <nav aria-label="Breadcrumb" class="text-[13px] text-ink-3 flex gap-2 mb-6">
      <a href="/" class="text-ink-3 no-underline">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/journal/" class="text-ink-3 no-underline">Journal</a>
      <span aria-hidden="true">/</span>
      <span>{category}</span>
    </nav>
    <h1 class="font-serif font-light text-[clamp(36px,5vw,72px)] leading-[1.02] tracking-[-0.025em] m-0 mb-6 text-balance">
      {title}
    </h1>
    <p class="text-[clamp(17px,1.4vw,20px)] leading-[1.6] text-ink-2 m-0 mb-8 text-pretty">
      {description}
    </p>
    <div class="flex gap-4 flex-wrap text-sm text-ink-3 items-center border-t border-taupe-line-3 pt-6">
      <span class="font-medium text-charcoal">{author}</span>
      <span>·</span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>·</span>
      <span>{readingTime}</span>
    </div>
  </div>

  <!-- Hero image -->
  <div class="max-w-site mx-auto px-gutter mb-[clamp(48px,6vw,80px)]">
    <div class="aspect-[21/9] rounded-sm overflow-hidden">
      <Picture
        src={getAssetImage(heroImage) ?? consultationHero}
        alt={title}
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        width={1360}
        height={583}
        formats={['avif', 'webp']}
      />
    </div>
  </div>

  <!-- Article body -->
  <div class="max-w-[680px] mx-auto px-gutter pb-[clamp(64px,8vw,100px)] text-lg leading-[1.75] text-[#3A3734]">
    <div class="article-body">
      <slot />
    </div>

    <div class="mt-10 p-5 px-6 bg-[#F0EDE7] rounded-sm text-sm leading-[1.6] text-ink-3">
      <strong class="text-charcoal">Medical disclaimer:</strong> This article is for general education only and is not a substitute for a consultation with a qualified provider. Individual results vary. Contact Skin Analysis for personalized guidance.
    </div>
  </div>

  <!-- Related treatments -->
  {treatments.length > 0 && (
    <div class="bg-sand">
      <div class="max-w-site mx-auto px-gutter py-section">
        <h2 class="font-serif font-light text-h2-md leading-[1.05] tracking-[-0.02em] m-0 mb-10">
          Treatments mentioned
        </h2>
        <div class="grid grid-auto-sm gap-[clamp(24px,2.4vw,36px)]">
          {treatments.map((t) => (
            <article class="flex flex-col gap-4">
              <a href={`/treatments/${t.id}/`} class="block aspect-[3/2] overflow-hidden rounded-sm no-underline img-zoom">
                <div class="zoom-inner w-full h-full">
                  <Picture
                    src={getAssetImage(t.data.heroImage) ?? consultationHero}
                    alt={t.data.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width={560}
                    height={373}
                    formats={['avif', 'webp']}
                  />
                </div>
              </a>
              <h3 class="font-serif font-normal text-[22px] m-0">
                <a href={`/treatments/${t.id}/`} class="text-charcoal no-underline transition-colors duration-[250ms] hover:text-clay">
                  {t.data.title}
                </a>
              </h3>
              <p class="text-sm leading-[1.6] text-ink-2 m-0">{t.data.benefit}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- CTA -->
  <div class="max-w-[1000px] mx-auto px-gutter py-section-lg text-center flex flex-col items-center gap-6">
    <h2 class="font-serif font-light text-[clamp(40px,5.2vw,76px)] leading-none tracking-[-0.025em] m-0">
      Ready to talk about your <em class="text-clay">skin?</em>
    </h2>
    <Btn href="/contact/">Book a Consultation</Btn>
  </div>

  <script>
    const bar = document.getElementById('reading-progress');
    if (bar) {
      window.addEventListener('scroll', () => {
        const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
        const pct = (scrollTop / (scrollHeight - clientHeight)) * 100;
        bar.style.width = Math.min(pct, 100) + '%';
      }, { passive: true });
    }
  </script>

  <style>
    .article-body h2 {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(28px, 3vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.015em;
      margin: 2.5em 0 0.75em;
      color: #2A2826;
    }
    .article-body p { margin: 0 0 1.5em; }
    .article-body blockquote {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 300;
      font-size: clamp(28px, 3.6vw, 40px);
      line-height: 1.2;
      color: #4F5E50;
      margin: 2em 0;
      padding: 0;
      border: none;
    }
    .article-body ul, .article-body ol {
      padding-left: 1.5em;
      margin: 0 0 1.5em;
    }
    .article-body li { margin-bottom: 0.5em; }
    .article-body strong { color: #2A2826; }
    .article-body a { color: #A8583D; border-bottom: 1px solid currentColor; }
  </style>
</BaseLayout>
