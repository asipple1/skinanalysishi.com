---
import BaseLayout from './BaseLayout.astro';
import Btn from '../components/Btn.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { Picture } from 'astro:assets';
import { getAssetImage } from '../lib/images';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  readingTime: string;
  heroImage: string;
  category: string;
  relatedTreatments?: string[];
}

const { title, description, pubDate, updatedDate, author, readingTime, heroImage, category } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: heroImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@id': 'https://www.skinanalysishi.com/#org' },
};
---

<BaseLayout
  title={`${title} | Skin Analysis Journal`}
  description={description}
  type="article"
  pubDate={pubDate}
  ogImage={heroImage}
  currentNav="Journal"
  schema={schema}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-0.5 bg-olivee z-200 transition-[width] duration-100"
    style="width:0%"
    aria-hidden="true"
  ></div>

  <!-- Article header -->
  <div class="max-w-235 mx-auto px-gutter pt-[clamp(40px,6vw,72px)] pb-[clamp(32px,4vw,48px)]">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Journal', href: '/journal/' }, { label: category }]} class="mb-6" />
    <h1 class="font-serif font-light text-[clamp(36px,5vw,72px)] leading-[1.02] tracking-tight m-0 mb-6 text-balance">
      {title}
    </h1>
    <p class="text-[clamp(17px,1.4vw,20px)] leading-[1.6] text-ink-2 m-0 mb-8 text-pretty">
      {description}
    </p>
    <div class="flex gap-4 flex-wrap text-sm text-ink-3 items-center border-t border-taupe-line-3 pt-6">
      <span class="font-medium text-charcoal">{author}</span>
      <span>·</span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>·</span>
      <span>{readingTime}</span>
    </div>
  </div>

  <!-- Hero image -->
  <div class="max-w-site mx-auto px-gutter mb-[clamp(48px,6vw,80px)]">
    <div class="aspect-21/9 overflow-hidden">
      {getAssetImage(heroImage) && (
        <Picture
          src={getAssetImage(heroImage)!}
          alt={title}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          width={1360}
          height={583}
          formats={['avif', 'webp']}
        />
      )}
    </div>
  </div>

  <!-- Article body -->
  <div class="max-w-170 mx-auto px-gutter pb-[clamp(64px,8vw,100px)] text-lg leading-[1.75] text-[#3A3734]">
    <div class="article-body">
      <slot />
    </div>

    <div class="mt-10 p-5 px-6 bg-[#F0EDE7] rounded-sm text-sm leading-[1.6] text-ink-3">
      <strong class="text-charcoal">Medical disclaimer:</strong> This article is for general education only and is not a substitute for a consultation with a qualified provider. Individual results vary. Contact Skin Analysis for personalized guidance.
    </div>
  </div>

  <!-- CTA -->
  <div class="max-w-250 mx-auto px-gutter py-section-lg text-center flex flex-col items-center gap-6">
    <h2 class="font-serif font-light text-[clamp(40px,5.2vw,76px)] leading-none tracking-tight m-0">
      Ready to talk about your <em class="text-olivee">skin?</em>
    </h2>
    <Btn href="/contact/">Book a Consultation</Btn>
  </div>

  <script>
    const bar = document.getElementById('reading-progress');
    if (bar) {
      window.addEventListener('scroll', () => {
        const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
        const pct = (scrollTop / (scrollHeight - clientHeight)) * 100;
        bar.style.width = Math.min(pct, 100) + '%';
      }, { passive: true });
    }
  </script>

  <style>
    .article-body :global(h2) {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(28px, 3vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.015em;
      margin: 2.5em 0 0.75em;
      color: #2A2826;
    }
    .article-body :global(h3) {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(22px, 2.4vw, 28px);
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin: 2em 0 0.6em;
      color: #2A2826;
    }
    .article-body :global(p) { margin: 0 0 0.05em; }
    .article-body :global(blockquote) {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 300;
      font-size: clamp(28px, 3.6vw, 40px);
      line-height: 1.2;
      color: #4F5E50;
      margin: 2em 0;
      padding: 0;
      border: none;
    }
    .article-body :global(ul), .article-body :global(ol) {
      padding-left: 1.5em;
      margin: 0 0 1.5em;
    }
    .article-body :global(li) { margin-bottom: 0.5em; }
    .article-body :global(strong) { color: #2A2826; }
    .article-body :global(a) { color: #A8583D; border-bottom: 1px solid currentColor; }
  </style>
</BaseLayout>
