---
import BaseHead from '../components/BaseHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/islands/CartDrawer';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  currentNav?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
}

const { title, description, canonical, ogImage, type, pubDate, currentNav, schema, noIndex } = Astro.props;

const globalSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://www.skinanalysishi.com/#website',
    url: 'https://www.skinanalysishi.com',
    name: 'Skin Analysis Medical Spa',
  },
  {
    '@context': 'https://schema.org',
    '@type': ['MedicalBusiness', 'MedicalClinic'],
    '@id': 'https://www.skinanalysishi.com/#org',
    name: 'Skin Analysis Medical Spa',
    legalName: 'Skin Analysis, LLC',
    url: 'https://www.skinanalysishi.com',
    telephone: '+18082138383',
    email: 'skinanalysishi@gmail.com',
    image: 'https://www.skinanalysishi.com/assets/palm-fronds-poster.webp',
    logo: 'https://www.skinanalysishi.com/assets/logo-light.webp',
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Oʻahu, Hawaiʻi',
    },
    priceRange: '$$',
    paymentAccepted: 'Credit Card, Debit Card',
    currenciesAccepted: 'USD',
    sameAs: [
      'https://www.instagram.com/skinanalysis_aesthetics/',
    ],
    department: [
      {
        '@type': ['MedicalBusiness', 'MedicalClinic'],
        '@id': 'https://www.skinanalysishi.com/#location-ewa-beach',
        name: 'Skin Analysis Medical Spa — Ewa Beach',
        url: 'https://www.skinanalysishi.com/contact/',
        telephone: '+18082138383',
        image: 'https://www.skinanalysishi.com/assets/palm-fronds-poster.webp',
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            opens: '08:30',
            closes: '18:00',
          },
        ],
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 21.32660,
          longitude: -158.01080,
        },
        hasMap: 'https://maps.google.com/?q=91-3475+Nana+Hope+Ewa+Beach+HI+96706',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '91-3475 Nana Hope',
          addressLocality: 'Ewa Beach',
          addressRegion: 'HI',
          postalCode: '96706',
          addressCountry: 'US',
        },
        branchOf: { '@id': 'https://www.skinanalysishi.com/#org' },
      },
      {
        '@type': ['MedicalBusiness', 'MedicalClinic'],
        '@id': 'https://www.skinanalysishi.com/#location-aiea',
        name: 'Skin Analysis Medical Spa — Aiea',
        url: 'https://www.skinanalysishi.com/contact/',
        telephone: '+18089791098',
        image: 'https://www.skinanalysishi.com/assets/palm-fronds-poster.webp',
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            opens: '08:30',
            closes: '18:00',
          },
        ],
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 21.38310,
          longitude: -157.93110,
        },
        hasMap: 'https://maps.google.com/?q=99-209+Moanalua+Rd+310+Aiea+HI+96701',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '99-209 Moanalua Rd. #310',
          addressLocality: 'Aiea',
          addressRegion: 'HI',
          postalCode: '96701',
          addressCountry: 'US',
        },
        branchOf: { '@id': 'https://www.skinanalysishi.com/#org' },
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
      noIndex={noIndex}
    />
    <SchemaOrg schema={globalSchema} />
    {schema && <SchemaOrg schema={schema} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header currentNav={currentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer client:idle />

    <!-- Mobile sticky booking bar -->
    <div id="mobile-book-bar" class="hidden fixed left-4 right-4 bottom-4 z-60">
      <a
        href="/contact/"
        class="block bg-charcoal text-ivory text-center py-4 text-[15px] font-medium shadow-[0_8px_24px_rgb(42_40_38/0.18)] no-underline"
      >
        Book an Appointment
      </a>
    </div>
    <script>
      const mobileBookBar = document.getElementById('mobile-book-bar');
      if (mobileBookBar && window.innerWidth < 960) {
        window.addEventListener('scroll', () => {
          mobileBookBar.style.display = window.scrollY > 700 ? 'block' : 'none';
        }, { passive: true });
      }
    </script>
    <script>
      // Scroll reveal
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('reveal-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        requestAnimationFrame(() => {
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top >= window.innerHeight) {
              el.classList.add('reveal-ready');
              io.observe(el);
            }
          });
        });
      }
    </script>
  </body>
</html>
