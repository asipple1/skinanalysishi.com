---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Btn from '../../components/Btn.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { getAssetImage } from '../../lib/images';
import providersTeam from '../../assets/site/providers-team.jpg';

export async function getStaticPaths() {
  const treatments = await getCollection('treatments');
  return treatments.map((t) => ({ params: { slug: t.id }, props: { treatment: t } }));
}

const { treatment: t } = Astro.props;
const d = t.data;

const allTreatments = await getCollection('treatments');
const relatedTreatments = d.related
  .map((slug: string) => allTreatments.find((x) => x.id === slug))
  .filter(Boolean);

const concerns = await getCollection('concerns');
const treatmentConcerns = d.concerns.map((slug: string) => concerns.find((c) => c.id === slug)).filter(Boolean);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: d.title,
    description: d.summary,
    provider: { '@id': 'https://www.skinanalysishi.com/#org' },
    areaServed: 'Oʻahu',
    offers: d.pricing.map((p: { label: string; value: string }) => {
      const numericPrice = parseFloat(p.value.replace(/[^0-9.]/g, ''));
      const offer: Record<string, unknown> = {
        '@type': 'Offer',
        name: p.label,
        priceCurrency: 'USD',
      };
      if (!isNaN(numericPrice)) {
        offer.price = numericPrice;
      } else {
        offer.priceSpecification = {
          '@type': 'PriceSpecification',
          priceCurrency: 'USD',
          description: p.value,
        };
      }
      return offer;
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((faq: { q: string; a: string }) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.skinanalysishi.com/' },
      { '@type': 'ListItem', position: 2, name: 'Treatments', item: 'https://www.skinanalysishi.com/treatments/' },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---

<BaseLayout
  title={d.seoTitle}
  description={d.metaDescription}
  currentNav="Treatments"
  schema={schema}
>
  <!-- Hero -->
  <section class="max-w-site mx-auto px-gutter pt-[clamp(32px,4vw,56px)] pb-[clamp(64px,8vw,110px)] grid gap-[clamp(36px,5vw,80px)] items-center" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr))">
    <div class="flex flex-col gap-6.5">
      <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Treatments', href: '/treatments/' }, { label: d.title }]} />
      <span class="text-xs tracking-[0.22em] uppercase text-sage">{d.category} on Oʻahu</span>
      <h1 class="font-serif font-light text-h1-lg leading-[0.98] tracking-tight m-0 text-balance">
        {d.title}
      </h1>
      <p class="text-body-lg leading-[1.6] text-ink-2 m-0 max-w-135 text-pretty">
        {d.summary}
      </p>
      <dl class="m-0 grid gap-[18px_24px] border-t border-taupe-line pt-5.5 max-w-140" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
        <div class="flex flex-col gap-1">
          <dt class="text-xs text-ink-3">Treatment time</dt>
          <dd class="m-0 text-[15px]">{d.time}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs text-ink-3">Social downtime</dt>
          <dd class="m-0 text-[15px]">{d.downtime}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs text-ink-3">Results appear</dt>
          <dd class="m-0 text-[15px]">{d.resultsAppear}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs text-ink-3">Typical plan</dt>
          <dd class="m-0 text-[15px]">{d.typicalPlan}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs text-ink-3">Pricing</dt>
          <dd class="m-0 text-[15px]">{d.priceFrom}</dd>
        </div>
      </dl>
      <div class="flex gap-3 flex-wrap">
        <Btn href="/contact/">Book {d.shortName}</Btn>
        <Btn href="#faq" variant="outline">Read FAQs</Btn>
      </div>
    </div>
      {getAssetImage(d.heroImage) && (
        <Picture
          src={getAssetImage(d.heroImage)!}
          alt={d.title}
          loading="eager"
          fetchpriority="high"
          width={600}
          height={750}
          formats={['avif', 'webp']}
        />
      )}
  </section>

  <!-- Who it's for + concerns -->
  <section class="bg-sand">
    <div class="max-w-site mx-auto px-gutter py-[clamp(40px,5vw,72px)] grid grid-auto-lg gap-[clamp(40px,6vw,100px)]">
      <div class="flex flex-col gap-5">
        <span class="text-xs tracking-[0.22em] uppercase text-sage">Who it's for</span>
        <div class="flex flex-col gap-4">
          {d.whoFor.split('\n\n').map((para: string) => para.trim() && (
            <p class="text-[17px] leading-[1.7] text-ink-2 m-0 text-pretty">{para.trim()}</p>
          ))}
        </div>
      </div>
      {treatmentConcerns.length > 0 && (
        <div class="flex flex-col gap-5">
          <span class="text-xs tracking-[0.22em] uppercase text-sage">Skin concerns treated</span>
          <div class="flex flex-wrap gap-2.5">
            {treatmentConcerns.map((c) => c && (
              <Btn href={`/skin-concerns/${c.id}/`} variant="ghost" size="sm">{c.data.title}</Btn>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-site mx-auto px-gutter py-[clamp(40px,5vw,72px)] grid grid-auto-xl gap-[clamp(40px,6vw,100px)] items-center">
    {(getAssetImage(d.secondaryImage) ?? getAssetImage(d.heroImage)) && (
      <div class="aspect-5/4 overflow-hidden">
        <Picture
          src={(getAssetImage(d.secondaryImage) ?? getAssetImage(d.heroImage))!}
          alt={`How ${d.title} works`}
          class="w-full h-full object-cover"
          loading="lazy"
          width={800}
          height={640}
          formats={['avif', 'webp']}
        />
      </div>
    )}
    <div class="flex flex-col gap-5.5">
      <span class="text-xs tracking-[0.22em] uppercase text-sage">How it works</span>
      <h2 class="font-serif font-light text-h2-lg leading-[1.02] tracking-[-0.02em] m-0">
        The science, <em>plainly.</em>
      </h2>
      <div class="flex flex-col gap-4">
          {d.howItWorks.split('\n\n').map((para: string) => para.trim() && (
            <p class="text-[17px] leading-[1.7] text-ink-2 m-0 text-pretty">{para.trim()}</p>
          ))}
        </div>
    </div>
  </section>

  <!-- Real Results -->
  {d.beforeAfter.length > 0 && (
    <section class="bg-sand">
      <div class="max-w-site mx-auto px-gutter py-[clamp(40px,5vw,72px)]">
        <div class={`grid grid-cols-1 gap-[clamp(40px,5vw,72px)]${d.beforeAfter.length > 1 ? ' lg:grid-cols-[3fr_2fr] lg:gap-x-[clamp(72px,8vw,120px)]' : ''}`}>
          <!-- Left: heading + featured image -->
          <div class="flex flex-col gap-7">
            <div class="flex flex-col gap-3">
              <span class="text-xs tracking-[0.22em] uppercase text-sage">Real results</span>
              <h2 class="font-serif font-light text-h2-lg leading-[1.02] tracking-[-0.02em] m-0 text-pretty">
                {d.realResultsHeadline ?? 'Before + After'}
              </h2>
            </div>
            <figure class="m-0 flex flex-col gap-3">
              <div class="relative overflow-hidden aspect-4/3 bg-ivory">
                {getAssetImage(d.beforeAfter[0].image) && (
                  <Picture
                    src={getAssetImage(d.beforeAfter[0].image)!}
                    alt={d.beforeAfter[0].caption}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width={880}
                    height={660}
                    formats={['avif', 'webp']}
                  />
                )}
              </div>
              <figcaption class="flex items-center gap-2 text-sm">
                {d.beforeAfter[0].caption.split(' · ').map((part: string, i: number, arr: string[]) => (
                  <>
                    <span class={i === 0 ? 'text-ink-2 font-medium' : 'text-ink-3'}>{part}</span>
                    {i < arr.length - 1 && <span class="text-taupe-line-3 select-none" aria-hidden="true">·</span>}
                  </>
                ))}
              </figcaption>
            </figure>
          </div>

          <!-- Right: remaining images stacked -->
          {d.beforeAfter.length > 1 && (
            <div class="flex flex-col gap-[clamp(28px,3vw,44px)] justify-center">
              {d.beforeAfter.slice(1).map((pair: { image: string; caption: string }) => (
                <figure class="m-0 flex flex-col gap-3">
                  <div class="relative overflow-hidden aspect-4/3 bg-ivory">
                    {getAssetImage(pair.image) && (
                      <Picture
                        src={getAssetImage(pair.image)!}
                        alt={pair.caption}
                        class="w-full h-full object-cover"
                        loading="lazy"
                        width={480}
                        height={360}
                        formats={['avif', 'webp']}
                      />
                    )}
                  </div>
                  <figcaption class="flex items-center gap-2 text-xs">
                    {pair.caption.split(' · ').map((part: string, i: number, arr: string[]) => (
                      <>
                        <span class={i === 0 ? 'text-ink-2 font-medium' : 'text-ink-3'}>{part}</span>
                        {i < arr.length - 1 && <span class="text-taupe-line-3 select-none" aria-hidden="true">·</span>}
                      </>
                    ))}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
        <p class="text-xs text-ink-3 mt-8 m-0">Individual results vary. Some images are provided by the device or product manufacturer.</p>
      </div>
    </section>
  )}

  <!-- Your Appointment -->
  <section class="border-t border-taupe-line-3">
    <div class="max-w-site mx-auto px-gutter py-[clamp(40px,5vw,72px)]">
      <span class="text-xs tracking-[0.22em] uppercase text-sage block mb-10">Your {d.shortName} appointment</span>
      <div class="flex flex-col sm:flex-row items-start">
        {d.expect.map((e: { step: string; text: string }, i: number) => (
          <div class="flex-1 flex flex-col min-w-0">
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full border border-taupe-line flex items-center justify-center text-xs tracking-wide text-ink-3 shrink-0 bg-ivory">
                {String(i + 1).padStart(2, '0')}
              </div>
              {i < d.expect.length - 1 && <div class="flex-1 h-px bg-taupe-line" />}
            </div>
            <div class="mt-5 pr-5 pb-8 sm:pb-0">
              <h3 class="font-serif font-normal text-[clamp(19px,1.6vw,24px)] m-0 mb-2">{e.step}</h3>
              <p class="text-[15px] leading-[1.65] text-ink-2 m-0">{e.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing + Provider note -->
  <section class="max-w-site mx-auto px-gutter py-[clamp(40px,5vw,72px)] grid grid-auto-lg gap-[clamp(48px,6vw,100px)]">
    <div class="flex flex-col gap-5.5">
      <span class="text-xs tracking-[0.22em] uppercase text-sage">Pricing</span>
      <h2 class="font-serif font-light text-h2-lg leading-[1.02] tracking-[-0.02em] m-0">
        Clear pricing, before you commit.
      </h2>
      <dl class="m-0 border-t border-taupe-line">
        {d.pricing.map((p: { label: string; value: string }) => (
          <div class="flex justify-between gap-5 py-4.5 border-b border-taupe-line text-base">
            <dt>{p.label}</dt>
            <dd class="m-0 font-medium text-right">{p.value}</dd>
          </div>
        ))}
      </dl>
      <p class="text-sm leading-[1.6] text-ink-3 m-0">
        Your plan and exact pricing are confirmed at your consultation. We're a cashless business and accept all major cards.
      </p>
    </div>
    <figure class="m-0 flex flex-col gap-7 bg-sage text-[#F3F0E8] p-[clamp(32px,4vw,56px)] rounded-sm self-start">
      <span class="text-xs tracking-[0.22em] uppercase text-sage-light">From your provider</span>
      <blockquote class="m-0 font-serif font-light text-[clamp(26px,2.6vw,36px)] leading-tight">
        &ldquo;{d.providerNote.quote}&rdquo;
      </blockquote>
      <figcaption class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-pill overflow-hidden shrink-0 bg-[#6A7E6B]">
          <Picture
            src={providersTeam}
            alt={d.providerNote.provider}
            class="w-full h-full object-cover"
            loading="lazy"
            width={56}
            height={56}
            formats={['avif', 'webp']}
          />
        </div>
        <span class="text-[15px]">{d.providerNote.provider}</span>
      </figcaption>
    </figure>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-taupe-line-3">
    <div class="max-w-250 mx-auto px-gutter py-[clamp(40px,5vw,72px)]">
      <h2 class="font-serif font-light text-h2-lg leading-[1.02] tracking-[-0.02em] m-0 mb-10">
        Questions we hear often
      </h2>
      <div class="border-t border-taupe-line">
        {d.faqs.map((faq: { q: string; a: string }, i: number) => (
          <details
            class="border-b border-taupe-line"
            open={i === 0}
          >
            <summary class="py-6 flex justify-between items-center gap-6 cursor-pointer list-none font-serif text-[clamp(21px,2vw,26px)] font-normal text-charcoal">
              <span>{faq.q}</span>
              <span aria-hidden="true" class="font-sans text-[22px] font-light shrink-0 transition-[transform] duration-300 faq-icon">+</span>
            </summary>
            <p class="text-base leading-[1.7] text-ink-2 m-0 pb-6.5 pr-12 max-w-190">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related treatments -->
  {relatedTreatments.length > 0 && (
    <section class="bg-sand">
      <div class="max-w-site mx-auto px-gutter py-[clamp(24px,3vw,40px)]">
        <h2 class="font-serif font-light text-[clamp(20px,2vw,26px)] leading-tight tracking-[-0.02em] m-0 mb-5">
          Often paired with
        </h2>
        <div class="flex flex-col gap-3">
          {relatedTreatments.map((r) => r && (
            <a href={`/treatments/${r.id}/`} class="flex gap-5 items-center no-underline group">
              {getAssetImage(r.data.heroImage) && (
                <div class="w-28 h-20 shrink-0 overflow-hidden bg-ivory">
                  <Picture
                    src={getAssetImage(r.data.heroImage)!}
                    alt={r.data.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                    width={224}
                    height={160}
                    formats={['avif', 'webp']}
                  />
                </div>
              )}
              <div class="flex flex-col gap-1">
                <span class="font-serif text-[18px] text-charcoal group-hover:text-olivee transition-colors duration-250">{r.data.title}</span>
                <span class="text-[13px] text-ink-3">{r.data.benefit}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="max-w-250 mx-auto px-gutter py-[clamp(56px,6vw,96px)] text-center flex flex-col items-center gap-6.5">
    <h2 class="font-serif font-light text-[clamp(42px,6vw,86px)] leading-[0.98] tracking-[-0.03em] m-0">
      Ready when you are.
    </h2>
    <p class="text-lg leading-[1.6] text-ink-2 m-0 max-w-130">
      Book {d.shortName} directly, or start with a complimentary consultation if you'd like to talk it through first.
    </p>
    <div class="flex gap-3 flex-wrap justify-center">
      <Btn href="/contact/">Book an Appointment</Btn>
      <Btn href="/contact/" variant="outline">Free Consultation</Btn>
    </div>
  </section>

  <style>
    details[open] .faq-icon { transform: rotate(45deg); }
    details summary::-webkit-details-marker { display: none; }
    details summary:hover { color: #A8583D; }
  </style>
</BaseLayout>
