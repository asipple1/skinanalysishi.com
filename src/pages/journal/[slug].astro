---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('journal', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const siteUrl = 'https://www.skinanalysishi.com';
const providers = await getCollection('providers');
const authorProvider = providers.find((p) => p.id === d.author);
const resolvedAuthor = authorProvider
  ? `${authorProvider.data.name}, ${authorProvider.data.credentials}`
  : d.author;
const authorUrl = authorProvider ? `${siteUrl}/about/${d.author}/` : undefined;
---

<ArticleLayout
  title={d.title}
  description={d.description}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  author={resolvedAuthor}
  authorUrl={authorUrl}
  readingTime={d.readingTime}
  heroImage={d.heroImage}
  category={d.category}
  relatedTreatments={d.relatedTreatments}
>
  <Content />
</ArticleLayout>
