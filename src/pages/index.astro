---
import BaseLayout from '../layouts/BaseLayout.astro';
import Btn from '../components/Btn.astro';
import ConcernExplorer from '../components/islands/ConcernExplorer';
import Testimonials from '../components/islands/Testimonials';
import ResultsFilter from '../components/islands/ResultsFilter';
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getAssetImage, consultationHero } from '../lib/images';
import heroPortrait from '../assets/hero-portrait.png';
import providersTeam from '../assets/providers-team.jpg';
import skincareProducts from '../assets/skincare-products.png';
import palmShadow from '../assets/palm-shadow.png';

const treatments = (await getCollection('treatments'))
  .filter((t) => t.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const concerns = (await getCollection('concerns'))
  .filter((c) => c.id !== 'unwanted-hair')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const testimonialEntries = await getCollection('testimonials');
const locations = await getCollection('locations');

import approachFactors from '../data/approach-factors.json';
import skincarebrands from '../data/skincare-brands.json';

const concernData = concerns.map((c) => ({
  name: c.data.title,
  slug: c.id,
  body: c.data.intro,
  image: c.data.image,
  treatments: c.data.treatments.slice(0, 3).map((slug: string) => {
    const t = treatments.find((x) => x.id === slug);
    return t?.data.shortName ?? slug;
  }),
  treatmentSlugs: c.data.treatments.slice(0, 3),
  link: `/skin-concerns/${c.id}/`,
}));

const treatmentsLarge = treatments.slice(0, 2);
const treatmentsSmall = treatments.slice(2, 6);

const palmShadowImg = await getImage({ src: palmShadow, format: 'webp' });

const results = await Promise.all([
  { title: 'Acne scarring', detail: 'SkinPen® series', tags: ['Acne', 'Texture', 'Microneedling'], image: '/assets/skinpen-ba-acne.png' },
  { title: 'Sun damage + freckles', detail: 'Peels + home care, 5 months', tags: ['Pigmentation'], image: '/assets/chemical-peel-ba-1.png' },
  { title: "Crow's feet", detail: 'Dysport®, 2 weeks after', tags: ['Injectables'], image: '/assets/dysport-ba-1.png' },
  { title: 'Melasma', detail: 'Peels + home care, 8 months', tags: ['Pigmentation'], image: '/assets/chemical-peel-ba-2.png' },
  { title: 'Acne + post-acne marks', detail: 'Peels + home care, 6 months', tags: ['Acne', 'Pigmentation'], image: '/assets/chemical-peel-ba-3.png' },
  { title: 'Neck lines', detail: '4 SkinPen® sessions', tags: ['Texture', 'Microneedling'], image: '/assets/skinpen-ba-neck.png' },
  { title: 'Forehead lines', detail: 'Dysport®, 2 weeks after', tags: ['Injectables'], image: '/assets/dysport-ba-2.png' },
  { title: 'Dull, congested skin', detail: 'DiamondGlow® series', tags: ['DiamondGlow', 'Acne'] },
].map(async (r) => ({
  ...r,
  image: r.image
    ? (await getImage({ src: getAssetImage(r.image)!, format: 'webp', width: 600, height: 450 })).src
    : undefined,
})));

const filters = ['All', 'Acne', 'Pigmentation', 'Texture', 'Microneedling', 'DiamondGlow', 'Injectables'];
---

<BaseLayout
  title="Medical Spa on Oʻahu | Skin Analysis, Ewa Beach + Aiea"
  description="Nurse-owned medical spa in Ewa Beach and Aiea, Oʻahu. Personalized, evidence-based skin treatments including DiamondGlow, SkinPen microneedling, Dysport, chemical peels and laser hair removal."
>
  <!-- 1. Hero -->
  <section id="top" aria-labelledby="hero-h" class="relative overflow-hidden">
    <div
      aria-hidden="true"
      style={`position:absolute;top:0;right:0;bottom:0;width:clamp(160px,18vw,300px);pointer-events:none;z-index:0;background:url(${palmShadowImg.src}) right center / cover no-repeat;mix-blend-mode:multiply;-webkit-mask-image:linear-gradient(to right, transparent, #000 45%);mask-image:linear-gradient(to right, transparent, #000 45%)`}
    ></div>
    <div class="relative z-[1] max-w-site mx-auto px-gutter pt-[clamp(28px,4vw,56px)] pb-[clamp(64px,8vw,120px)] grid grid-auto-md gap-[clamp(36px,5vw,80px)] items-center">
      <div data-reveal class="flex flex-col gap-7 max-w-[600px]">
        <span class="eyebrow">Ewa Beach + Aiea, Oʻahu</span>
        <h1 id="hero-h" class="font-serif font-light text-display leading-[0.98] tracking-[-0.025em] m-0 text-balance">
          Healthy skin starts with <em class="text-clay">understanding</em> yours.
        </h1>
        <p class="text-body-lg leading-[1.6] text-ink-2 m-0 max-w-[520px] text-pretty">
          At Skin Analysis, we take the time to understand your skin, lifestyle, and goals before recommending treatment. Our approach combines medical expertise, thoughtful guidance, and personalized care designed to support healthy skin for the long term.
        </p>
        <div class="flex gap-[14px] flex-wrap mt-[6px]">
          <Btn href="/contact/">Start With a Consultation <span aria-hidden="true">→</span></Btn>
          <Btn href="/treatments/" variant="secondary">Explore Treatments <span aria-hidden="true">→</span></Btn>
        </div>
      </div>
      <div data-reveal class="relative max-w-[600px] w-full justify-self-end">
        <div>
          <Picture
            src={heroPortrait}
            alt="Provider portrait in soft natural light"
            class="w-full h-full object-cover object-[center_20%]"
            loading="eager"
            fetchpriority="high"
            width={604}
            height={772}
            formats={['avif', 'webp']}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Statement -->
  <section aria-labelledby="season-h" class="bg-sand">
    <div data-reveal class="max-w-[1100px] mx-auto px-gutter flex flex-col gap-10" style="padding-block:clamp(70px,9.6vw,144px)">
      <h2 id="season-h" class="font-serif font-light text-h1-lg leading-[1.02] tracking-[-0.025em] m-0 text-balance">
        Nourish your skin through every <em>season</em> of life.
      </h2>
      <div class="grid grid-auto-2col gap-8 max-w-[860px] ml-auto">
        <p class="text-[17px] leading-[1.65] text-ink-2 m-0 text-pretty">
          Skin in your twenties behaves differently from skin after pregnancy, through perimenopause, or after years of island sun. Hormones, stress, and routines shift, and your skin shifts with them.
        </p>
        <p class="text-[17px] leading-[1.65] text-ink-2 m-0 text-pretty">
          Your treatment plan should change too. We revisit it as you do, so the care you receive fits the skin you have now.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Concern Explorer -->
  <section id="concerns" aria-labelledby="concerns-h" class="max-w-site mx-auto px-gutter py-section-lg">
    <div data-reveal class="flex justify-between items-end gap-6 flex-wrap mb-[clamp(40px,5vw,72px)]">
      <div class="flex flex-col gap-[18px]">
        <span class="eyebrow">Explore by concern</span>
        <h2 id="concerns-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0">
          What would you like to work on?
        </h2>
      </div>
      <p class="text-base leading-[1.6] text-ink-3 max-w-[380px] m-0">
        You don't need to know the name of a treatment. Start with what you're noticing.
      </p>
    </div>
    <ConcernExplorer client:visible concerns={concernData} />
  </section>

  <!-- 4. Featured Treatments -->
  <section id="treatments" aria-labelledby="treat-h" class="border-t border-taupe-line-3">
    <div class="max-w-site mx-auto px-gutter py-section-lg">
      <div data-reveal class="flex justify-between items-end gap-6 flex-wrap mb-[clamp(40px,5vw,72px)]">
        <div class="flex flex-col gap-[18px]">
          <span class="eyebrow">Featured treatments</span>
          <h2 id="treat-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0">
            Treatments we trust.
          </h2>
        </div>
        <a
          href="/treatments/"
          class="text-[15px] font-medium border-b border-charcoal pb-1 no-underline text-charcoal transition-[color,border-color] duration-[250ms] hover:text-clay hover:border-clay"
        >
          View all treatments
        </a>
      </div>

      <!-- Large tiles (first 2) -->
      <div class="grid grid-auto-xl gap-[clamp(28px,3vw,44px)] mb-[clamp(56px,6vw,88px)]">
        {treatmentsLarge.map((t) => (
          <article data-reveal class="flex flex-col gap-[22px]">
            <a href={`/treatments/${t.id}/`} aria-label={`Explore ${t.data.title}`} class="block aspect-[5/4] overflow-hidden no-underline img-zoom">
              <div class="zoom-inner w-full h-full">
                <Picture
                  src={getAssetImage(t.data.heroImage) ?? consultationHero}
                  alt={t.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width={800}
                  height={640}
                  formats={['avif', 'webp']}
                />
              </div>
            </a>
            <div class="grid gap-[10px_24px] items-baseline" style="grid-template-columns:1fr auto">
              <h3 class="font-serif font-normal text-[clamp(28px,2.8vw,40px)] leading-[1.05] m-0 tracking-[-0.015em]">{t.data.title}</h3>
              <span class="text-sm text-ink-3 whitespace-nowrap">{t.data.priceFrom}</span>
              <p class="text-base leading-[1.6] text-ink-2 m-0 max-w-[480px]">{t.data.benefit}</p>
              <span class="text-sm text-ink-3 whitespace-nowrap">{t.data.time}</span>
            </div>
            <a
              href={`/treatments/${t.id}/`}
              class="text-[15px] font-medium flex gap-2 items-center self-start border-b border-charcoal pb-[3px] no-underline text-charcoal transition-[color,border-color] duration-[250ms] hover:text-clay hover:border-clay"
            >
              Explore Treatment <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <!-- Small tiles (next 4) -->
      <div class="grid gap-[clamp(24px,2.4vw,36px)]" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))">
        {treatmentsSmall.map((t) => (
          <article data-reveal class="flex flex-col gap-[18px]">
            <a href={`/treatments/${t.id}/`} aria-label={`Explore ${t.data.title}`} class="block aspect-[4/5] overflow-hidden no-underline img-zoom">
              <div class="zoom-inner w-full h-full">
                <Picture
                  src={getAssetImage(t.data.heroImage) ?? consultationHero}
                  alt={t.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width={400}
                  height={500}
                  formats={['avif', 'webp']}
                />
              </div>
            </a>
            <h3 class="font-serif font-normal text-[26px] leading-[1.1] m-0">{t.data.title}</h3>
            <p class="text-[15px] leading-[1.6] text-ink-2 m-0">{t.data.benefit}</p>
            <div class="flex justify-between gap-3 text-[13px] text-ink-3 border-t border-taupe-line-3 pt-3">
              <span>{t.data.time}</span><span>{t.data.priceFrom}</span>
            </div>
            <a
              href={`/treatments/${t.id}/`}
              class="text-sm font-medium flex gap-2 items-center no-underline text-charcoal transition-colors duration-[250ms] hover:text-clay"
            >
              Explore Treatment <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Approach -->
  <section id="approach" aria-labelledby="approach-h" class="bg-sage text-[#F3F0E8]">
    <div class="max-w-site mx-auto px-gutter py-[clamp(88px,11vw,170px)] grid grid-auto-xl gap-[clamp(48px,7vw,120px)]">
      <div data-reveal class="flex flex-col gap-[30px]">
        <span class="text-xs tracking-[0.22em] uppercase text-sage-light">Our approach</span>
        <h2 id="approach-h" class="font-serif font-light text-[clamp(40px,5.2vw,76px)] leading-none tracking-[-0.025em] m-0 text-balance">
          Your skin doesn't need a trend. It needs a <em>plan.</em>
        </h2>
        <p class="text-[17px] leading-[1.65] text-sage-text m-0 max-w-[480px] text-pretty">
          A treatment is only right if it's right for you. Before we recommend anything, we look at the whole picture, then explain our reasoning so you can make an informed decision. Sometimes that means fewer treatments, not more.
        </p>
        <a
          href="/#approach"
          class="self-start bg-[#F3F0E8] text-charcoal px-7 py-4 rounded-pill text-[15px] font-medium transition-[background] duration-[250ms] no-underline hover:bg-white"
        >
          Our Approach
        </a>
      </div>
      <div data-reveal class="flex flex-col">
        <span class="text-[13px] text-sage-light mb-[18px]">What shapes your recommendation</span>
        <ol class="list-none m-0 p-0 border-t border-[rgba(243,240,232,0.25)]">
          {approachFactors.map((f, i) => (
            <li class="grid gap-3 items-baseline py-[18px] border-b border-[rgba(243,240,232,0.25)]" style="grid-template-columns:44px 1fr">
              <span class="text-xs tracking-[0.1em] text-sage-light" style="font-variant-numeric:tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="flex flex-col gap-1">
                <span class="font-serif text-[clamp(24px,2.2vw,30px)] font-light leading-[1.15]">{f.name}</span>
                <span class="text-sm leading-[1.5] text-sage-light">{f.note}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 6. Providers -->
  <section id="about" aria-labelledby="about-h" class="max-w-site mx-auto px-gutter py-section-lg">
    <div class="grid gap-[clamp(40px,6vw,100px)] items-center" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr))">
      <div data-reveal class="aspect-[4/5] overflow-hidden">
        <Picture
          src={providersTeam}
          alt="Sarah and Allison together in the studio"
          class="w-full h-full object-cover"
          loading="lazy"
          width={800}
          height={1000}
          formats={['avif', 'webp']}
        />
      </div>
      <div data-reveal class="flex flex-col gap-9">
        <div class="flex flex-col gap-[22px]">
          <span class="eyebrow">Meet Sarah + Allison</span>
          <h2 id="about-h" class="font-serif font-light text-[clamp(38px,4.8vw,68px)] leading-none tracking-[-0.02em] m-0">
            Care rooted in experience.
          </h2>
          <p class="text-[17px] leading-[1.65] text-ink-2 m-0 text-pretty">
            Skin Analysis is owned and run by a board-certified family nurse practitioner and a registered nurse with more than two decades of combined experience in dermatology and aesthetics. You'll see one of them at every visit.
          </p>
        </div>
        <div class="grid gap-8 border-t border-taupe-line pt-8" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">
          <div class="flex flex-col gap-3">
            <h3 class="font-serif font-normal text-[24px] leading-[1.15] m-0">
              Sarah Lockwood-Sepulveda, <span class="text-[17px] text-ink-3">FNP-BC</span>
            </h3>
            <span class="text-[13px] text-sage">Owner + Aesthetic Provider</span>
            <p class="text-[15px] leading-[1.6] text-ink-2 m-0">
              Sarah sees skin health as part of overall health. She provides injectables, microneedling, chemical peels, and dermaplaning.
            </p>
            <a href="/#about" class="text-sm font-medium flex gap-2 text-charcoal no-underline transition-colors duration-[250ms] hover:text-clay">
              Read Sarah's profile <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="font-serif font-normal text-[24px] leading-[1.15] m-0">
              Allison Sipple, <span class="text-[17px] text-ink-3">RN-BSN</span>
            </h3>
            <span class="text-[13px] text-sage">Owner + Aesthetic Provider</span>
            <p class="text-[15px] leading-[1.6] text-ink-2 m-0">
              Allison listens first. She builds plans around each person's goals, lifestyle, and comfort level, and keeps learning so her approach stays current.
            </p>
            <a href="/#about" class="text-sm font-medium flex gap-2 text-charcoal no-underline transition-colors duration-[250ms] hover:text-clay">
              Read Allison's profile <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Results -->
  <section id="results" aria-labelledby="results-h" class="bg-sand">
    <div class="max-w-site mx-auto px-gutter py-section-lg">
      <div data-reveal class="flex justify-between items-end gap-6 flex-wrap mb-10">
        <div class="flex flex-col gap-[18px]">
          <span class="eyebrow">Results</span>
          <h2 id="results-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0">
            Gradual, visible change.
          </h2>
        </div>
        <p class="text-[15px] leading-[1.6] text-ink-3 max-w-[360px] m-0">
          Consistent lighting and positioning. Some images are provided by device and product manufacturers.
        </p>
      </div>
      <ResultsFilter client:visible results={results} filters={filters} />
      <p class="text-[13px] leading-[1.6] text-ink-3 mt-10 m-0 max-w-[720px]">
        Individual results vary. Outcomes depend on skin type, condition, number of treatments, and home care. Images are not a guarantee of results.
      </p>
    </div>
  </section>

  <!-- 8. Testimonials -->
  <section aria-labelledby="voices-h">
    <Testimonials
      client:visible
      testimonials={testimonialEntries.map((t) => ({ text: t.data.text, name: t.data.name, detail: t.data.detail }))}
    />
  </section>

  <!-- 9. Skincare -->
  <section id="skincare" aria-labelledby="skincare-h" class="border-t border-taupe-line-3">
    <div class="max-w-site mx-auto px-gutter py-section-lg grid grid-auto-xl gap-[clamp(40px,6vw,100px)] items-center">
      <div data-reveal class="flex flex-col gap-7">
        <span class="eyebrow">Professional skincare</span>
        <h2 id="skincare-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0 text-balance">
          What you do between appointments <em>matters</em> too.
        </h2>
        <p class="text-[17px] leading-[1.65] text-ink-2 m-0 max-w-[500px] text-pretty">
          In-office treatments work best when your daily routine supports them. We carry a small set of professional lines we use ourselves, and we'll tell you which products you need and which you can skip.
        </p>
        <ul class="list-none mt-2 m-0 p-0 border-t border-taupe-line">
          {skincarebrands.map((b) => (
            <li class="flex justify-between items-baseline gap-4 py-4 border-b border-taupe-line">
              <span class="font-serif text-[24px] font-normal">{b.name}</span>
              <span class="text-sm text-ink-3 text-right">{b.note}</span>
            </li>
          ))}
        </ul>
        <a
          href="/shop/"
          class="self-start px-7 py-4 rounded-pill text-[15px] font-medium border border-charcoal transition-all duration-[250ms] no-underline text-charcoal hover:bg-charcoal hover:text-ivory"
        >
          Explore Skincare
        </a>
      </div>
      <div data-reveal class="aspect-[4/5] overflow-hidden">
        <Picture
          src={skincareProducts}
          alt="Professional skincare products on natural stone in soft daylight"
          class="w-full h-full object-cover"
          loading="lazy"
          width={552}
          height={754}
          formats={['avif', 'webp']}
        />
      </div>
    </div>
  </section>

  <!-- 10. Locations -->
  <section id="locations" aria-labelledby="loc-h" class="bg-sand">
    <div class="max-w-site mx-auto px-gutter py-section-lg">
      <div data-reveal class="flex justify-between items-end gap-6 flex-wrap mb-[clamp(40px,5vw,64px)]">
        <div class="flex flex-col gap-[18px]">
          <span class="eyebrow">Locations</span>
          <h2 id="loc-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0">
            Two studios on Oʻahu.
          </h2>
        </div>
        <p class="text-[15px] leading-[1.6] text-ink-3 max-w-[360px] m-0">
          Open by appointment only. We're a cashless business and accept all major credit and debit cards.
        </p>
      </div>
      <div class="grid grid-2col-loc gap-[clamp(32px,4vw,56px)]">
        {locations.map((l) => (
          <article data-reveal class="flex flex-col gap-6">
            <div class="aspect-[3/2] overflow-hidden bg-taupe-line">
              <div class="w-full h-full bg-taupe-line-2 flex items-center justify-center text-warm-muted font-serif text-lg">
                {l.data.name}
              </div>
            </div>
            <div class="flex justify-between items-baseline gap-3 flex-wrap">
              <h3 class="font-serif font-normal text-[clamp(30px,3vw,42px)] m-0 tracking-[-0.015em]">{l.data.name}</h3>
              <span class="text-[13px] text-sage">{l.data.tag}</span>
            </div>
            <dl class="dl-grid text-[15px] leading-[1.5] border-t border-taupe-line pt-5 m-0">
              <dt class="text-ink-3">Address</dt>
              <dd class="m-0">{l.data.streetAddress}, {l.data.locality}, {l.data.region}</dd>
              <dt class="text-ink-3">Appointments</dt>
              <dd class="m-0">{l.data.appointments}</dd>
              <dt class="text-ink-3">Phone</dt>
              <dd class="m-0">
                <a href={`tel:${l.data.tel}`} class="text-charcoal no-underline transition-colors duration-[250ms] hover:text-clay">
                  {l.data.phone}
                </a>
              </dd>
            </dl>
            <div class="flex gap-3 flex-wrap">
              <Btn href="/contact/" size="sm">Book in {l.data.name}</Btn>
              <Btn href={l.data.mapUrl} target="_blank" rel="noopener" variant="outline" size="sm">Get Directions</Btn>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. Final CTA -->
  <section id="book" aria-labelledby="book-h" class="max-w-[1100px] mx-auto px-gutter py-[clamp(110px,14vw,200px)] text-center flex flex-col items-center gap-[30px]">
    <h2
      id="book-h"
      data-reveal
      class="font-serif font-light text-[clamp(46px,7vw,104px)] leading-[0.98] tracking-[-0.03em] m-0"
    >
      Not sure where to <em class="text-clay">start?</em>
    </h2>
    <p class="text-[clamp(17px,1.4vw,20px)] leading-[1.6] text-ink-2 m-0 max-w-[560px] text-pretty">
      You don't need to know which treatment you need before visiting us. That's what your consultation is for.
    </p>
    <Btn href="/contact/" size="lg" class="mt-2">Book a Complimentary Consultation</Btn>
    <span class="text-sm text-ink-3">
      Or call <a href="tel:+18082138383" class="border-b border-taupe-line-2 no-underline text-charcoal transition-colors duration-[250ms] hover:text-clay">808.213.8383</a>
    </span>
  </section>

  <!-- Mobile sticky booking bar -->
  <div id="mobile-book-bar" class="hidden fixed left-4 right-4 bottom-4 z-[60]">
    <a
      href="/contact/"
      class="block bg-charcoal text-ivory text-center py-4 rounded-pill text-[15px] font-medium shadow-[0_8px_24px_rgb(42_40_38/0.18)] no-underline"
    >
      Book an Appointment
    </a>
  </div>
  <script>
    const bar = document.getElementById('mobile-book-bar');
    if (bar && window.innerWidth < 960) {
      window.addEventListener('scroll', () => {
        bar.style.display = window.scrollY > 700 ? 'block' : 'none';
      }, { passive: true });
    }
  </script>
</BaseLayout>
