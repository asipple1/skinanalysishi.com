---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/heroes/HomeHero.astro';
import BrandPhilosophy from '../components/sections/BrandPhilosophy.astro';
import SkinConcerns from '../components/sections/SkinConcerns.astro';
import FeaturedTreatments from '../components/sections/FeaturedTreatments.astro';
import RealResults from '../components/sections/RealResults.astro';
import Providers from '../components/sections/Providers.astro';
import OurApproach from '../components/sections/OurApproach.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import Locations from '../components/sections/Locations.astro';
import BookCTA from '../components/sections/BookCTA.astro';
---

<BaseLayout
  title="Medical Spa on Oʻahu | Skin Analysis, Ewa Beach + Aiea"
  description="Nurse-owned medical spa in Ewa Beach and Aiea, Oʻahu. Personalized, evidence-based skin treatments including DiamondGlow, SkinPen microneedling, Dysport, chemical peels and dermaplaning."
>
  <HomeHero />
  <BrandPhilosophy />
  <SkinConcerns />
  <FeaturedTreatments />
  <RealResults />
  <Providers />
  <OurApproach />
  <TestimonialsSection />
  <Locations />
  <BookCTA />

  <!-- Mobile sticky booking bar -->
  <div id="mobile-book-bar" class="hidden fixed left-4 right-4 bottom-4 z-[60]">
    <a
      href="/contact/"
      class="block bg-charcoal text-ivory text-center py-4 rounded-pill text-[15px] font-medium shadow-[0_8px_24px_rgb(42_40_38/0.18)] no-underline"
    >
      Book an Appointment
    </a>
  </div>
  <script>
    const bar = document.getElementById('mobile-book-bar');
    if (bar && window.innerWidth < 960) {
      window.addEventListener('scroll', () => {
        bar.style.display = window.scrollY > 700 ? 'block' : 'none';
      }, { passive: true });
    }
  </script>
</BaseLayout>
