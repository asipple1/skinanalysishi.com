---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Btn from '../../components/Btn.astro';
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAssetImage } from '../../lib/images';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((p) => ({ params: { slug: p.id }, props: { provider: p } }));
}

const { provider: p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
---

<BaseLayout
  title={`${d.name}, ${d.credentials} | Skin Analysis`}
  description={d.summary}
  currentNav="About"
>
  <div class="max-w-site mx-auto px-gutter py-section-sm">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: d.name }]} class="mb-10" />

    <!-- Profile -->
    <div class="grid gap-[clamp(48px,7vw,100px)] items-start" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr))">

      <!-- Photo -->
      {getAssetImage(d.photo) && (
        <div class="aspect-square overflow-hidden">
          <Picture
            src={getAssetImage(d.photo)!}
            alt={d.name}
            class="w-full h-full object-cover"
            loading="eager"
            width={800}
            height={800}
            formats={['avif', 'webp']}
          />
        </div>
      )}

      <!-- Bio -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
          <span class="eyebrow">{d.role}</span>
          <h1 class="font-serif font-light text-[clamp(38px,4.8vw,68px)] leading-none tracking-[-0.02em] m-0">
            {d.name}<span class="text-[0.5em] text-ink-3 ml-3 align-middle">{d.credentials}</span>
          </h1>
        </div>

        <p class="text-[17px] leading-[1.65] text-ink-2 m-0 text-pretty">
          {d.summary}
        </p>

        <div class="prose-content border-t border-taupe-line pt-8 text-[17px] leading-[1.7] text-ink-2">
          <Content />
        </div>

        <div class="flex gap-3 flex-wrap border-t border-taupe-line pt-8">
          <Btn href="/contact/">Book an Appointment</Btn>
          <Btn href="/about/" variant="outline">Meet the Team</Btn>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
