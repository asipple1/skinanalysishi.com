---
interface Props {
  title: string;
  badge?: string;
  faq?: boolean;
}
const { title, badge, faq = false } = Astro.props;
---

<details
  class="sa-accordion"
  {...faq ? { itemscope: true, itemprop: 'mainEntity', itemtype: 'https://schema.org/Question' } : {}}
>
  <summary>
    <span class="sa-accordion__label" {...faq ? { itemprop: 'name' } : {}}>
      {badge && <span class="sa-accordion__badge">{badge}</span>}
      {title}
    </span>
    <svg class="sa-accordion__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </summary>
  <div
    class="sa-accordion__body"
    {...faq ? { itemscope: true, itemprop: 'acceptedAnswer', itemtype: 'https://schema.org/Answer' } : {}}
  >
    <div {...faq ? { itemprop: 'text' } : {}}>
      <slot />
    </div>
  </div>
</details>

<style>
  .sa-accordion {
    border-bottom: 1px solid #e8e3dc;
    margin: 0;
  }

  .sa-accordion > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem 0;
    cursor: pointer;
    user-select: none;
  }
  .sa-accordion > summary::-webkit-details-marker,
  .sa-accordion > summary::marker {
    display: none;
    content: '';
  }

  .sa-accordion__label {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.3;
    color: #2a2826;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .sa-accordion__badge {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8583d;
    background: #f5ede8;
    padding: 2px 8px;
    border-radius: 3px;
    white-space: nowrap;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }

  .sa-accordion__chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.22s ease;
    color: #a8583d;
  }

  .sa-accordion[open] > summary .sa-accordion__chevron {
    transform: rotate(180deg);
  }

  .sa-accordion__body {
    padding-bottom: 1.75rem;
  }
</style>
