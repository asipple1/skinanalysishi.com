---
import ResultsFilter from '../islands/ResultsFilter';
import { getImage } from 'astro:assets';
import { getAssetImage } from '../../lib/images';

const results = await Promise.all([
  { title: 'Acne scarring',        detail: 'SkinPen® series',                tags: ['Acne', 'Texture', 'Microneedling'], image: '/assets/treaments/skinpen-microneedling/skinpen-ba-acne.png' },
  { title: 'Sun damage + freckles', detail: 'Peels + home care, 5 months',    tags: ['Pigmentation'],                    image: '/assets/treaments/chemical-peels/chemical-peel-ba-1.png' },
  { title: "Crow's feet",           detail: 'Dysport®, 2 weeks after',         tags: ['Injectables'],                     image: '/assets/treaments/dysport/dysport-ba-1.png' },
  { title: 'Melasma',               detail: 'Peels + home care, 8 months',     tags: ['Pigmentation'],                    image: '/assets/treaments/chemical-peels/chemical-peel-ba-2.png' },
  { title: 'Acne + post-acne marks',detail: 'Peels + home care, 6 months',     tags: ['Acne', 'Pigmentation'],            image: '/assets/treaments/chemical-peels/chemical-peel-ba-3.png' },
  { title: 'Neck lines',            detail: '4 SkinPen® sessions',             tags: ['Texture', 'Microneedling'],        image: '/assets/treaments/skinpen-microneedling/skinpen-ba-neck.png' },
  { title: 'Forehead lines',        detail: 'Dysport®, 2 weeks after',         tags: ['Injectables'],                     image: '/assets/treaments/dysport/dysport-ba-2.png' },
  { title: 'Dull, congested skin',  detail: 'DiamondGlow® series',             tags: ['DiamondGlow', 'Acne'] },
].map(async (r) => ({
  ...r,
  image: r.image
    ? (await getImage({ src: getAssetImage(r.image)!, format: 'webp', width: 600, height: 450 })).src
    : undefined,
})));

const filters = ['All', 'Acne', 'Pigmentation', 'Texture', 'Microneedling', 'DiamondGlow', 'Injectables'];
---

<section id="results" aria-labelledby="results-h" class="bg-sand">
  <div class="max-w-site mx-auto px-gutter py-section-lg">
    <div data-reveal class="flex justify-between items-end gap-6 flex-wrap mb-10">
      <div class="flex flex-col gap-[18px]">
        <span class="eyebrow">Results</span>
        <h2 id="results-h" class="font-serif font-light text-h2-xl leading-[1.02] tracking-[-0.02em] m-0">
          Gradual, visible change.
        </h2>
      </div>
    </div>
    <ResultsFilter client:visible results={results} filters={filters} />
    <p class="text-[13px] leading-[1.6] text-ink-3 mt-10 m-0 max-w-[720px]">
      Individual results vary. Outcomes depend on skin type, condition, number of treatments, and home care. Images are not a guarantee of results.
    </p>
  </div>
</section>
