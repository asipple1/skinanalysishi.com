---
import Btn from '../Btn.astro';
---

<section id="book" aria-labelledby="book-h" class="max-w-[1100px] mx-auto px-gutter py-[clamp(110px,14vw,200px)] text-center flex flex-col items-center gap-[30px]">
  <h2
    id="book-h"
    data-reveal
    class="font-serif font-light text-[clamp(46px,7vw,104px)] leading-[0.98] tracking-[-0.03em] m-0"
  >
    Not sure where to <em class="text-clay">start?</em>
  </h2>
  <p class="text-[clamp(17px,1.4vw,20px)] leading-[1.6] text-ink-2 m-0 max-w-[560px] text-pretty">
    You don't need to know which treatment you need before visiting us. That's what your consultation is for.
  </p>
  <Btn href="/contact/" size="lg" class="mt-2">Book a Complimentary Consultation</Btn>
  <span class="text-sm text-ink-3">
    Or call <a href="tel:+18082138383" class="border-b border-taupe-line-2 no-underline text-charcoal transition-colors duration-[250ms] hover:text-clay">808.213.8383</a>
  </span>
</section>
