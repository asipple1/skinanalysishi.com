---
import Btn from "../Btn.astro";
import { Picture } from "astro:assets";
import heroPortrait from "../../assets/site/hero-image.jpg";
import palmFrondsPosterSrc from "../../assets/site/palm-fronds-poster.webp";
import sharp from "sharp";
import { encode, decode } from "blurhash";
import { join } from "path";

const imgPath = join(process.cwd(), "src/assets/site/hero-image.jpg");

const { data, info } = await sharp(imgPath)
  .resize(32, 48, { fit: "cover" })
  .ensureAlpha()
  .raw()
  .toBuffer({ resolveWithObject: true });

const hash = encode(new Uint8ClampedArray(data), info.width, info.height, 4, 4);

const pixels = decode(hash, 32, 48);
const placeholderBuf = await sharp(Buffer.from(pixels), {
  raw: { width: 32, height: 48, channels: 4 },
})
  .jpeg({ quality: 60 })
  .toBuffer();

const placeholder = `data:image/jpeg;base64,${placeholderBuf.toString("base64")}`;
---

<section id="top" aria-labelledby="hero-h" class="relative overflow-hidden">
  <!-- Palm frond layer — poster image shows instantly, video overlays once loaded -->
  <div aria-hidden="true" class="palm-fronds-wrap">
    <Picture
      src={palmFrondsPosterSrc}
      alt=""
      class="palm-poster"
      widths={[320, 480, 640, 960, 1280]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="lazy"
    />
    <video class="palm-video" autoplay loop muted playsinline preload="none">
      <source src="/assets/palm-fronds-1.mp4" type="video/mp4" />
    </video>
  </div>

  <div
    class="relative z-2 max-w-site mx-auto px-gutter pt-[clamp(28px,4vw,56px)] pb-[clamp(40px,10vw,140px)] grid grid-auto-md gap-[clamp(36px,5vw,80px)] items-center"
  >
    <div data-reveal class="flex flex-col gap-7 max-w-[600px]">
      <span class="eyebrow">Ewa Beach + Aiea, Oʻahu</span>
      <h1
        id="hero-h"
        class="font-serif font-light text-display leading-[0.98] tracking-[-0.025em] m-0 text-balance"
      >
        Healthy skin starts with <em class="text-olive">understanding</em> yours.
      </h1>
      <p
        class="text-body-lg leading-[1.65] text-ink-2 m-0 max-w-[520px] text-pretty"
      >
        At Skin Analysis, we take the time to understand your skin, lifestyle,
        and goals before recommending treatment. Our approach combines medical
        expertise, thoughtful guidance, and personalized care designed to
        support healthy skin for the long term.
      </p>
      <div class="flex gap-[14px] flex-wrap mt-[6px]">
        <Btn href="/contact/"
          >Start With a Consultation <span aria-hidden="true">→</span></Btn
        >
        <Btn href="/treatments/" variant="secondary"
          >Explore Treatments <span aria-hidden="true">→</span></Btn
        >
      </div>
    </div>
    <div
      data-reveal
      class="hero-portrait relative max-w-[600px] w-full justify-self-end"
      style={`background-image: url('${placeholder}'); background-size: cover; background-position: center 20%;`}
    >
      <Picture
        src={heroPortrait}
        alt="Sarah and Allison, owners and aesthetic providers at Skin Analysis Medical Spa, Oʻahu"
        class="hero-img w-full h-full object-cover object-[center_20%]"
        loading="eager"
        fetchpriority="high"
        width={604}
        height={772}
        formats={["avif", "webp"]}
      />
    </div>
  </div>
</section>

<style>
  /* Green palm frond layer — sits above shadow, behind portrait */
  .palm-fronds-wrap {
    position: absolute;
    top: 0%;
    right: -3%;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    /* Fade out at bottom and left edges so fronds blend naturally */
    -webkit-mask-image:
      linear-gradient(to bottom, #000 45%, transparent 98%),
      linear-gradient(to left, #000 35%, transparent 82%);
    mask-image:
      linear-gradient(to bottom, #000 45%, transparent 98%),
      linear-gradient(to left, #000 35%, transparent 82%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .palm-fronds-wrap :global(picture) {
    display: block;
    position: absolute;
    inset: 0;
  }

  .palm-poster,
  .palm-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
    opacity: 0.6;
    mix-blend-mode: luminosity;
  }

  @media (max-width: 875px) {
    .hero-portrait {
      display: none;
    }

    .palm-fronds-wrap {
      top: 0;
      height: 100%;
    }

    .palm-poster,
    .palm-video {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palm-video {
      display: none;
    }
  }

  .hero-img {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero-img.is-loaded {
    opacity: 1;
  }
</style>

<script>
  const img = document.querySelector<HTMLImageElement>(".hero-img");
  if (img) {
    if (img.complete) {
      img.classList.add("is-loaded");
    } else {
      img.addEventListener("load", () => img.classList.add("is-loaded"));
    }
  }
</script>
