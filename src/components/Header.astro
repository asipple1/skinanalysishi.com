---
import CartButton from './islands/CartButton';
import Btn from './Btn.astro';
import { Picture } from 'astro:assets';
import logoLight from '../assets/site/logo-light.webp';

interface Props {
  currentNav?: string;
}
const { currentNav } = Astro.props;

const navItems = [
  { label: 'Skin Concerns', href: '/#concerns' },
  { label: 'Treatments', href: '/treatments/' },
  { label: 'About', href: '/about/' },
  { label: 'Skincare Shop', href: '/shop/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'Locations', href: '/contact/#locations' },
];
---

<div id="site-header-wrapper" class="sticky top-0 z-50 block">
  <!-- Announcement bar -->
  <div
    id="announcement-bar"
    class="bg-charcoal text-sand text-[13px] tracking-[0.04em] px-6 py-[10px] flex justify-center gap-7 flex-wrap text-center overflow-hidden transition-[max-height,padding,opacity] duration-300"
    style="max-height:60px;opacity:1"
  >
    <span>Ewa Beach + Aiea, Oʻahu</span>
    <span class="text-sage-mid">Complimentary consultations available</span>
  </div>

  <!-- Nav -->
  <header
    id="site-nav"
    class="bg-ivory/[0.94] backdrop-blur-md border-b border-b-transparent transition-[border-color] duration-300"
  >
    <div class="max-w-site px-gutter py-[18px] flex items-center justify-between gap-6">
      <!-- Logo -->
      <a href="/" aria-label="Skin Analysis home" class="flex items-center no-underline shrink-0">
        <Picture
          src={logoLight}
          alt="Skin Analysis Medical Spa"
          width={200}
          height={77}
          loading="eager"
          fetchpriority="high"
          formats={['avif', 'webp']}
          sizes="(min-width: 1024px) 200px, 130px"
          class="w-32.5 lg:w-50 h-auto"
        />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Primary" class="desktop-nav flex gap-[30px] text-[15px]">
        {navItems.map(({ label, href }) => (
          <Btn
            href={href}
            variant="nav"
            active={label === currentNav}
            aria-current={label === currentNav ? 'page' : undefined}
          >
            {label}
          </Btn>
        ))}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3 shrink-0">
        <CartButton client:idle />
        <a
          href="tel:+18082138383"
          class="phone-link text-charcoal text-[14px] font-medium no-underline hover:text-olive transition-colors duration-200 whitespace-nowrap"
        >
          808-213-8383
        </a>
        <a
          href="/contact/"
          class="book-btn bg-charcoal text-ivory px-[22px] py-3 text-sm font-medium whitespace-nowrap no-underline transition-[background] duration-[250ms] hover:bg-olive"
        >
          Book an Appointment
        </a>
        <!-- Mobile menu toggle — vanilla JS, no Preact island -->
        <button
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav-overlay"
          aria-label="Open menu"
          class="mobile-menu-btn bg-transparent border border-taupe-line rounded-pill size-11 flex flex-col items-center justify-center gap-1.25 cursor-pointer"
        >
          <span class="menu-bars flex flex-col items-center gap-1.25">
            <span class="w-4 h-[1.5px] bg-charcoal block"></span>
            <span class="w-4 h-[1.5px] bg-charcoal block"></span>
          </span>
          <span class="menu-close hidden text-lg text-charcoal leading-none">×</span>
        </button>
      </div>
    </div>
  </header>
</div>

<!-- Mobile nav overlay — rendered outside the sticky/backdrop-filter wrapper so
     position:fixed is relative to the viewport, not the header's containing block. -->
<nav
  id="mobile-nav-overlay"
  aria-label="Mobile"
  class="mobile-nav-overlay fixed inset-x-0 bottom-0 bg-ivory z-199 flex flex-col px-gutter pt-6 pb-10 overflow-y-auto"
  style="top: var(--header-h, 80px); display: none;"
>
  {navItems.map(({ label, href }) => (
    <a
      href={href}
      class="mobile-nav-link font-serif text-[30px] py-3.5 border-b border-sand text-charcoal no-underline"
    >
      {label}
    </a>
  ))}
  <a
    href="tel:+18082138383"
    class="mt-8 text-charcoal text-[17px] font-medium no-underline text-center"
  >
    808-213-8383
  </a>
  <div class="mt-8 flex gap-7 items-center justify-center">
    <a
      href="https://www.instagram.com/skinanalysis_aesthetics/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="text-black opacity-90 hover:opacity-100 transition-opacity duration-200"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
    </a>
    <a
      href="https://www.youtube.com/@skinanalysisaesthetics"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="YouTube"
      class="text-black opacity-90 hover:opacity-100 transition-opacity duration-200"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="34" height="34" aria-hidden="true">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
    </a>
  </div>
</nav>

<!-- Sticky bottom call bar — mobile only -->
<div id="call-bar" class="call-bar fixed bottom-0 inset-x-0 z-198 bg-charcoal safe-bottom">
  <a
    href="tel:+18082138383"
    class="flex items-center justify-center gap-2.5 text-ivory text-[15px] font-medium no-underline py-4"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
    </svg>
    Call to Book — 808-213-8383
  </a>
</div>

<script>
  const bar = document.getElementById('announcement-bar') as HTMLElement | null;
  const nav = document.getElementById('site-nav') as HTMLElement | null;
  const wrapper = document.getElementById('site-header-wrapper') as HTMLElement | null;
  const menuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const overlay = document.getElementById('mobile-nav-overlay') as HTMLElement | null;
  const callBar = document.getElementById('call-bar') as HTMLElement | null;

  // Write header height to a CSS variable — read by the overlay's top position.
  const updateHeaderH = () => {
    if (wrapper) {
      document.documentElement.style.setProperty('--header-h', wrapper.offsetHeight + 'px');
    }
  };
  updateHeaderH();
  window.addEventListener('resize', updateHeaderH, { passive: true });

  // Mobile nav toggle — vanilla JS, no Preact.
  const setNavOpen = (open: boolean) => {
    if (!menuBtn || !overlay) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    const bars = menuBtn.querySelector('.menu-bars') as HTMLElement | null;
    const close = menuBtn.querySelector('.menu-close') as HTMLElement | null;
    if (bars) bars.style.display = open ? 'none' : 'flex';
    if (close) close.classList.toggle('hidden', !open);
    overlay.style.display = open ? 'flex' : 'none';
    callBar?.classList.toggle('nav-open', open);
    if (open) {
      const sw = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = sw + 'px';
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.paddingRight = '';
      document.body.style.overflow = '';
    }
  };

  menuBtn?.addEventListener('click', () => {
    setNavOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  overlay?.querySelectorAll('.mobile-nav-link').forEach(a => {
    a.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') setNavOpen(false);
  });

  let collapsed = false;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;

    if (bar) {
      if (!collapsed && y > 60) {
        collapsed = true;
        bar.style.maxHeight = '0';
        bar.style.paddingTop = '0';
        bar.style.paddingBottom = '0';
        bar.style.opacity = '0';
      } else if (collapsed && y < 20) {
        collapsed = false;
        bar.style.maxHeight = '60px';
        bar.style.paddingTop = '10px';
        bar.style.paddingBottom = '10px';
        bar.style.opacity = '1';
      }
    }

    if (nav) nav.style.borderBottomColor = y > 8 ? '#E6DED2' : 'transparent';
  }, { passive: true });
</script>

<style>
  .mobile-menu-btn { display: none; }

  @media (max-width: 959px) {
    .desktop-nav { display: none !important; }
    .mobile-menu-btn { display: flex; }
  }
  @media (max-width: 767px) {
    .phone-link { display: none; }
  }
  @media (max-width: 599px) {
    .book-btn { display: none; }
  }
  .call-bar { display: none; }
  @media (max-width: 959px) {
    .call-bar { display: block; padding-bottom: env(safe-area-inset-bottom, 0px); }
  }
  .call-bar.nav-open { display: none; }
</style>
